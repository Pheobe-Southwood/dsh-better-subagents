    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": { "node": ">=20.19.0" },
  "repository": { "type": "git", "url": "git+https://github.com/Pheobe-Southwood/dsh-better-subagents.git" },
