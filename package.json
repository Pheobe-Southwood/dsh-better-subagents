  "homepage": "https://github.com/Pheobe-Southwood/dsh-better-subagents#readme",
  "keywords": ["deepseek-harness", "dsh", "subagent", "llm", "model-selection", "cordis"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "peerDependencies": { "@deepseek-ai/cordis": "^4.0.2" },
